# Что не нужно в установке у клиента: composer ставит пакет архивом,
# и тесты с примерами только занимают место в его vendor/.
/.github            export-ignore
/tests              export-ignore
/examples           export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml        export-ignore

# Переводы строк в исходниках одинаковые на всех системах.
*.php               text eol=lf
*.json              text eol=lf
*.md                text eol=lf
*.yml               text eol=lf
